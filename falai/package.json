{
  "name": "@gusnips/falai",
  "version": "1.0.0",
  "description": "Same package as @falai/agent, under the @gusnips name. Installs @falai/agent and re-exports all of it.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts"
  ],
  "keywords": [
    "alias",
    "@falai/agent"
  ],
  "author": "Gustavo Salomé (gusnips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/npm-aliases.git",
    "directory": "falai"
  },
  "homepage": "https://falai.dev",
  "bugs": {
    "url": "https://github.com/falai-dev/agent/issues"
  },
  "dependencies": {
    "@falai/agent": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
