{
  "name": "@gusnips/netcup",
  "version": "1.2.0",
  "description": "The netcup-sdk command and JavaScript client under the @gusnips name.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    }
  },
  "bin": {
    "netcup": "cli.js"
  },
  "files": [
    "cli.js",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts"
  ],
  "keywords": [
    "alias",
    "netcup",
    "netcup-sdk"
  ],
  "author": "Gustavo Salomé (gusnips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/npm-aliases.git",
    "directory": "netcup"
  },
  "homepage": "https://github.com/gusnips/netcup#readme",
  "bugs": {
    "url": "https://github.com/gusnips/netcup/issues"
  },
  "dependencies": {
    "netcup-sdk": ">=0.3.0 <1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
